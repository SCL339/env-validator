{
  "name": "env-validator",
  "version": "1.0.0",
  "description": "Validate .env files against .env.example — detect missing keys, extra keys, and type mismatches. Works as both a CLI tool and a GitHub Action.",
  "bin": {
    "env-validator": "./bin/env-validator.js"
  },
  "main": "lib/validator.js",
  "files": [
    "bin/",
    "lib/",
    "action.yml",
    "action/"
  ],
  "keywords": [
    "env-validator",
    "env-validation",
    "dotenv",
    "env-example",
    "environment-variables",
    "env-check",
    "config-validation",
    "github-action",
    "env-security",
    "type-check"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCL339/env-validator.git"
  },
  "bugs": {
    "url": "https://github.com/SCL339/env-validator/issues"
  },
  "homepage": "https://github.com/SCL339/env-validator#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0"
  }
}
